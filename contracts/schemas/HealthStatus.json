{
  "$defs": {
    "ArtifactState": {
      "enum": [
        "NOT_LOADED",
        "UNVALIDATED",
        "VALIDATED"
      ],
      "title": "ArtifactState",
      "type": "string"
    },
    "ComponentHealth": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ModuleStatus"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ComponentHealth",
      "type": "object"
    },
    "ModelArtifactStatus": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "title": "Module",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ArtifactState"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "module",
        "state"
      ],
      "title": "ModelArtifactStatus",
      "type": "object"
    },
    "ModuleStatus": {
      "enum": [
        "AVAILABLE",
        "LOW_QUALITY",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ModuleStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "service_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Service Version",
      "type": "string"
    },
    "contract_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModuleStatus"
    },
    "components": {
      "additionalProperties": {
        "$ref": "#/$defs/ComponentHealth"
      },
      "title": "Components",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ModelArtifactStatus"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "service_version",
    "contract_version",
    "status",
    "components",
    "artifacts",
    "timestamp"
  ],
  "title": "HealthStatus",
  "type": "object"
}
