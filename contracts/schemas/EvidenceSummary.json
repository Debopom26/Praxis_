{
  "$defs": {
    "ModuleStatus": {
      "enum": [
        "AVAILABLE",
        "LOW_QUALITY",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ModuleStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "module": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Module",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModuleStatus"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    }
  },
  "required": [
    "module",
    "status",
    "reason_codes"
  ],
  "title": "EvidenceSummary",
  "type": "object"
}
