{
  "$defs": {
    "ModuleStatus": {
      "enum": [
        "AVAILABLE",
        "LOW_QUALITY",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ModuleStatus",
      "type": "string"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "text": {
          "maxLength": 8000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "transcript",
      "default": "transcript",
      "title": "Type",
      "type": "string"
    },
    "call_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Call Id",
      "type": "string"
    },
    "text": {
      "maxLength": 32000,
      "title": "Text",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Language"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality"
    },
    "status": {
      "$ref": "#/$defs/ModuleStatus"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Version"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "analysis_english": {
      "anyOf": [
        {
          "maxLength": 32000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis English"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "call_id",
    "text",
    "language",
    "segments",
    "quality",
    "status",
    "model_version",
    "latency_ms",
    "timestamp"
  ],
  "title": "TranscriptEvent",
  "type": "object"
}
