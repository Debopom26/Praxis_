{
  "$defs": {
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "title": "Module",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ModuleStatus"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "model_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        }
      },
      "required": [
        "module",
        "status",
        "reason_codes"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "ModuleStatus": {
      "enum": [
        "AVAILABLE",
        "LOW_QUALITY",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ModuleStatus",
      "type": "string"
    },
    "PolicyAction": {
      "enum": [
        "ALLOW",
        "WARN",
        "SECONDARY_VERIFICATION",
        "ESCALATE",
        "HOLD"
      ],
      "title": "PolicyAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Event Type",
      "type": "string"
    },
    "call_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Id"
    },
    "window_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Id"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "model_versions": {
      "additionalProperties": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Versions",
      "type": "object"
    },
    "calibration_versions": {
      "additionalProperties": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Calibration Versions",
      "type": "object"
    },
    "risk_model_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Model Version"
    },
    "policy_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "profile_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Version"
    },
    "threshold_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold Version"
    },
    "context_config_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Config Version"
    },
    "retention_config_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Config Version"
    },
    "evidence_summary": {
      "items": {
        "$ref": "#/$defs/EvidenceSummary"
      },
      "title": "Evidence Summary",
      "type": "array"
    },
    "final_risk": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Risk"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/ModuleStatus"
    },
    "quality": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Quality",
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "session_id",
    "event_id",
    "event_type",
    "timestamp",
    "status"
  ],
  "title": "AuditEvent",
  "type": "object"
}
