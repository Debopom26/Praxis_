{
  "$defs": {
    "ArtifactState": {
      "enum": [
        "NOT_LOADED",
        "UNVALIDATED",
        "VALIDATED"
      ],
      "title": "ArtifactState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "module": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@-]+$",
      "title": "Module",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ArtifactState"
    },
    "version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "module",
    "state"
  ],
  "title": "ModelArtifactStatus",
  "type": "object"
}
