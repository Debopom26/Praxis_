<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- Only debug builds trust the dedicated Praxis local development CA. -->
    <debug-overrides>
        <trust-anchors><certificates src="@raw/praxis_local_ca" /></trust-anchors>
    </debug-overrides>
</network-security-config>
