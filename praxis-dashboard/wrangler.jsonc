{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "praxisdashboard",
  "main": "worker.ts",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "kv_namespaces": [{ "binding": "PRAXIS_TUNNEL", "id": "77af896cead141689aba0798ad19ebfc" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
