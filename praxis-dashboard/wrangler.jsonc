{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "praxisdashboard",
  "main": "worker.ts",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
